# Exemplo de variáveis de ambiente para os servidores MCP
# NUNCA commite o arquivo .env.mcp real no Git!
# Exporte estas variáveis no seu ~/.zshrc ou ~/.bashrc (ou carregue localmente fora do repo).

# Token Fine-Grained do GitHub com permissão mínima para o repositório CHAMA_beckend
GITHUB_TOKEN=github_pat_seu_token_aqui

# String de conexão SOMENTE LEITURA (usuário readonly) para o banco de desenvolvimento
DATABASE_READONLY_URL=postgresql://chama_readonly:senha_segura@localhost:5432/chama_dev
