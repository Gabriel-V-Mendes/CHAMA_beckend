# Configurações gerais da aplicação
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Banco de dados PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/chama
DB_USERNAME=chama_app
DB_PASSWORD=troque_por_senha_forte

# Segurança / JWT (mínimo 32 caracteres / 256 bits)
JWT_SECRET=troque_por_chave_aleatoria_com_pelo_menos_32_caracteres
JWT_ISSUER=chama-backend
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
BCRYPT_STRENGTH=12

# CORS e Rate Limit
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
AUTH_RATE_LIMIT_PER_MINUTE=10
